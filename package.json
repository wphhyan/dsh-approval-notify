{
  "name": "dsh-approval-notify",
  "version": "1.3.2",
  "description": "macOS Notification Center alerts for the four moments a DSH agent waits on you: a tool approval, an ask_user_question prompt, a finished turn, and a session error.",
  "type": "module",
  "license": "MIT",
  "author": "wphhyan",
  "homepage": "https://github.com/wphhyan/dsh-approval-notify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wphhyan/dsh-approval-notify.git"
  },
  "bugs": {
    "url": "https://github.com/wphhyan/dsh-approval-notify/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "macos",
    "notification",
    "approval",
    "desktop-notification"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
